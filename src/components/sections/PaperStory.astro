---
/**
 * "The paper game, reinvented" — the page's one big scroll moment.
 *
 * Desktop with motion: the section pins; one scroll timeline plays the sheet (WebGL fold →
 * phone → accordion → signatures) while the step text swaps in place beside it.
 * Phones and reduced motion: no pinning and no WebGL — each step shows its own still
 * picture (plain HTML/CSS): the folded paper, the phone, the signed story.
 */
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import paperImage from '../../assets/img/paper.png';
import Wordmark from '../../assets/img/unfolded-wordmark.svg';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Signatures from './Signatures.astro';

interface Props {
  intro: CollectionEntry<'site'>['data']['story'];
  steps: CollectionEntry<'story'>[];
  /** The hero's sheet — the same story carries on down the page. */
  sheet: CollectionEntry<'site'>['data']['hero']['sheet'];
}

const { intro, steps, sheet } = Astro.props;
const paper = await getImage({ src: paperImage, format: 'webp', width: 920, quality: 80 });
const screenButton = steps.find((s) => s.data.visual === 'phone')?.data.screenButton;
const { finalStory = [], signers = [] } = steps.find((s) => s.data.visual === 'sheet')?.data ?? {};
// Each fold of the accordion holds one sentence; the last one also holds the signatures.
const [firstLine, ...restLines] = finalStory;
// Phone picture 1 types its lines in: one span per letter (inside a span per word, so lines
// only ever break between words). The letters take their place from the start — nothing reflows.
const typed = (text: string) => text.split(' ').map((word) => [...word]);
// Phone picture 2 shows the next player's turn, using the story's second line.
const received = finalStory[1] ?? { join: sheet.next, rest: '' };
// Phone picture 1 ends on the app's waiting screen, with the next player's avatar.
const avatarFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/avatars/*.png', { eager: true });
const sent = steps.find((s) => s.data.visual === 'paper')?.data.sent;
const sentAvatarFile = sent && avatarFiles[`../../assets/img/avatars/${sent.avatar}.png`]?.default;
const sentAvatar = sentAvatarFile ? await getImage({ src: sentAvatarFile, format: 'webp', width: 208 }) : null;
---

<section class="story" id="how-it-works" aria-labelledby="story-title">
  <Container>
    <div class="story__grid">
      <!-- The heading lives with the steps, so it stays in place when the section pins. -->
      <div class="story__copy">
      <header class="story__intro" data-reveal>
        <p class="eyebrow">{intro.eyebrow}</p>
        <Heading level={2} id="story-title">{intro.title}</Heading>
      </header>

      <ol class="story__steps">
        {
          steps.map(({ data }, i) => (
            <li class="story__step" data-visual={data.visual}>
              {/* Phones and reduced motion: a still picture of this step (no WebGL). */}
              <div class="story__still" aria-hidden="true" style={`--paper-texture: url(${paper.src})`}>
                {data.visual === 'paper' && (
                  <div class="still-fold">
                    {/* Phones with motion: the top half folds back out of sight as it comes into view. */}
                    <div class="still-fold__flap">
                      <p>
                        {sheet.theirs}{' '}
                        <span data-type="mine">
                          {typed(sheet.mine).map((word, i) => (
                            <>{i > 0 && ' '}<span class="w">{word.map((c) => <span class="ch">{c}</span>)}</span></>
                          ))}
                        </span>
                      </p>
                      <span class="still-fold__shade" />
                    </div>
                    <div class="still-paper">
                      <span class="still-paper__bands" />
                      <p data-type="next">
                        {typed(sheet.next).map((word, i) => (
                          <>{i > 0 && ' '}<span class="w">{word.map((c) => <span class="ch">{c}</span>)}</span></>
                        ))}
                      </p>
                    </div>
                    {/* The app's button: "Fold the page", then "Send" — inactive until you type. */}
                    <span class="still-fold__button">
                      <span data-label="fold">{sheet.foldLabel}</span>
                      <span data-label="send">{screenButton}</span>
                    </span>
                    {sent && (
                      <div class="still-sent">
                        <p class="still-sent__title">{sent.title}</p>
                        <span
                          class="still-sent__avatar"
                          style={sentAvatar ? `background-image: url(${sentAvatar.src})` : undefined}
                        />
                        <span class="still-sent__typing">
                          <span />
                          <span />
                          <span />
                        </span>
                        <p class="still-sent__text">{sent.nextTurn}</p>
                      </div>
                    )}
                  </div>
                )}
                {data.visual === 'phone' && (
                  <div class="still-phone">
                    {/* Phones with motion: this outline draws itself in place of the CSS border. */}
                    <svg class="still-phone__outline" viewBox="0 0 220 448" preserveAspectRatio="none">
                      <rect x="1.5" y="1.5" width="217" height="445" rx="32.5" pathLength="100" />
                    </svg>
                    <span class="still-phone__speaker" />
                    <Wordmark class="still-phone__logo" />
                    {/* The next player's turn: the note arrives showing only the start the last
                        player left (bold), and they finish the sentence (it types in on phones). */}
                    <div class="still-paper still-paper--small">
                      <span class="still-paper__bands" />
                      <p>
                        <b>{received.join}</b>{' '}
                        <span data-type="reply">
                          {typed(received.rest).map((word, i) => (
                            <>{i > 0 && ' '}<span class="w">{word.map((c) => <span class="ch">{c}</span>)}</span></>
                          ))}
                        </span>
                      </p>
                    </div>
                    <span class="still-phone__button">{sheet.foldLabel}</span>
                  </div>
                )}
                {data.visual === 'sheet' && (
                  <div class="still-story">
                    {finalStory.map((line) => (
                      <p>
                        <b>{line.join}</b> {line.rest}
                      </p>
                    ))}
                    <Signatures names={signers} />
                  </div>
                )}
              </div>
              <div class="story__step-inner">
              <span class="story__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <Heading level={3} size="2xl">
                {data.title}
              </Heading>
              <p>{data.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      </div>

      <!-- Decorative: the steps' text says everything the picture shows. -->
      <div class="story__stage" aria-hidden="true">
        <div
          class="story__visual"
          data-state="loading"
          data-paper={paper.src}
          data-theirs={sheet.theirs}
          data-mine={sheet.mine}
          data-next={sheet.next}
          style={`--paper-texture: url(${paper.src})`}
        >
          <div class="story__sheet">
            <canvas class="story__canvas"></canvas>

          </div>

          <!-- Step 3: the folded strip opens like an accordion — one sentence per fold — and everyone signs. -->
          {
            firstLine && (
              <div class="accordion">
                <span class="accordion__layers" />
                <div class="fold">
                  <p class="fold__face">
                    <b>{firstLine.join}</b> {firstLine.rest}
                  </p>
                  {restLines.reduceRight<any>(
                    (inner, line, i) => (
                      <div class="fold fold--hinged" data-fold={i + 1}>
                        <div class="fold__face">
                          <p>
                            <b>{line.join}</b> {line.rest}
                          </p>
                          {i === restLines.length - 1 && <Signatures names={signers} />}
                        </div>
                        <span class="fold__shade" />
                        {inner}
                      </div>
                    ),
                    null,
                  )}
                </div>
              </div>
            )
          }

          <!-- Step 2: a phone draws in around the folded sheet — the app's writing screen. -->
          <div class="phone">
            <svg class="phone__outline" viewBox="0 0 250 510" preserveAspectRatio="none">
              <rect x="1.5" y="1.5" width="247" height="507" rx="38" pathLength="100"></rect>
            </svg>
            <span class="phone__speaker phone__part"></span>
            <Wordmark class="phone__logo phone__part" />
            {screenButton && <span class="phone__button phone__part">{screenButton}</span>}
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import { gsap, ScrollTrigger } from '../../scripts/motion';
  import type { PaperFold } from '../../scripts/paper-fold';

  const section = document.querySelector<HTMLElement>('.story')!;
  const grid = section.querySelector<HTMLElement>('.story__grid')!;
  const visual = section.querySelector<HTMLElement>('.story__visual')!;
  const sheetEl = section.querySelector<HTMLElement>('.story__sheet')!;
  const canvas = section.querySelector<HTMLCanvasElement>('.story__canvas')!;
  const steps = [...section.querySelectorAll<HTMLElement>('.story__step')];
  const { paper, theirs, mine, next } = visual.dataset as Record<string, string>;

  // The WebGL sheet loads lazily (below); until then, and without WebGL, scroll still drives
  // everything else. `fold` remembers where the fold should be so the sheet can catch up.
  let sheet: PaperFold | null = null;
  const fold = { progress: 0 };
  const setFold = (p: number) => {
    fold.progress = p;
    sheet?.setProgress(p);
  };

  const mm = gsap.matchMedia();

  // Desktop with motion: the section pins in place; scrolling plays the story while the
  // text on the left swaps in place, step by step. Set up straight away (not lazily) so the
  // page has its full scroll length from the start — reloading mid-section lands correctly.
  mm.add('(min-width: 960px) and (prefers-reduced-motion: no-preference)', () => {
    section.classList.add('is-scrolly');

    const accordion = section.querySelector<HTMLElement>('.accordion')!;
    const hinged = [...section.querySelectorAll<HTMLElement>('.fold--hinged')];
    const firstFold = section.querySelector<HTMLElement>('.fold__face')!;
    const boxH = () => sheetEl.offsetHeight;
    // Keep the strip centred while it grows: centred as one fold, centred again fully open.
    const openH = () =>
      firstFold.offsetHeight +
      hinged.reduce((h, f) => h + f.querySelector<HTMLElement>(':scope > .fold__face')!.offsetHeight, 0);

    // Timeline units ≈ half a screen of scroll each (see `end`).
    const S1 = 0; // the paper game: fold, then glide up
    const S2 = 1.15; // onto the phone
    const S3 = 2.3; // unfold together (gets the most room)
    const LEN3 = 1.85;
    const END = S3 + LEN3 + 0.3; // + a short hold on the signed story

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: grid,
        start: 'center center',
        end: () => `+=${END * 0.5 * innerHeight}`,
        pin: true,
        scrub: true,
        invalidateOnRefresh: true,
      },
    });

    // Text swaps in place: the outgoing step lifts away, the next one rises in.
    const swap = (from: HTMLElement, to: HTMLElement, at: number) =>
      tl
        .to(from, { opacity: 0, y: -16, duration: 0.12 }, at)
        .fromTo(to, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.12 }, at + 0.08);

    // Step 1 — the sheet folds over the top lines, then glides up into the space the folded half left.
    tl.fromTo(fold, { progress: 0 }, { progress: 1, duration: 0.75, onUpdate: () => setFold(fold.progress) }, S1)
      .fromTo(sheetEl, { y: 0 }, { y: () => -sheetEl.offsetHeight * 0.2, duration: 0.25 }, S1 + 0.75);

    // Step 2 — the folded sheet shrinks to screen size, then a phone outline draws in around it;
    // the app's wordmark and "Send" button appear last.
    swap(steps[0], steps[1], S2 - 0.1);
    tl.to(sheetEl, { scale: 0.5, duration: 0.47 }, S2)
      .fromTo(section.querySelector('.phone__outline rect'), { strokeDashoffset: 100 }, { strokeDashoffset: 0, duration: 0.51 }, S2 + 0.26)
      .fromTo(section.querySelectorAll('.phone__part'), { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.17, stagger: 0.05 }, S2 + 0.64);

    // Step 3 — the phone fades, the folded sheet becomes a folded strip, the strip opens like an
    // accordion (one sentence per fold), then everyone signs.
    const at3 = (t: number) => S3 + t * LEN3; // positions as fractions of step 3
    swap(steps[1], steps[2], S3 - 0.1);
    tl.fromTo(section.querySelector('.phone'), { opacity: 1 }, { opacity: 0, duration: 0.1 * LEN3 }, at3(0))
      .fromTo(sheetEl, { opacity: 1 }, { opacity: 0, duration: 0.1 * LEN3 }, at3(0.05))
      .fromTo(
        accordion,
        { opacity: 0, y: () => (boxH() - firstFold.offsetHeight) / 2 },
        { opacity: 1, duration: 0.1 * LEN3 },
        at3(0.07),
      )
      // a short pause on the folded strip, then it opens
      .to(accordion, { y: () => (boxH() - openH()) / 2, duration: 0.56 * LEN3, ease: 'power1.inOut' }, at3(0.22))
      .to(section.querySelector('.accordion__layers'), { opacity: 0, duration: 0.1 * LEN3 }, at3(0.22));
    hinged.forEach((f, i) => {
      const at = at3(0.22 + i * 0.19);
      // Hidden until its turn: nested folds add up their tilts, so a waiting fold could face the viewer.
      tl.fromTo(f, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.001 }, at)
        .fromTo(f, { rotateX: -110 }, { rotateX: 0, duration: 0.2 * LEN3, ease: 'power2.out' }, at)
        .fromTo(f.querySelector(':scope > .fold__shade'), { opacity: 0.5 }, { opacity: 0, duration: 0.2 * LEN3 }, at);
    });
    // The signatures write themselves in, left to right, one after another.
    tl.fromTo(
      section.querySelectorAll('.signature'),
      { clipPath: 'inset(-20% 100% -20% 0)' },
      { clipPath: 'inset(-20% 0% -20% 0)', duration: 0.05 * LEN3, stagger: 0.04 * LEN3 },
      at3(0.8),
    ).to({}, { duration: 0.3 }, S3 + LEN3); // hold

    return () => section.classList.remove('is-scrolly');
  });

  // Phones with motion: each still plays a short version of its desktop moment, once, when it
  // comes into view (not scrubbed — a link jump never lands mid-animation).
  mm.add('(max-width: 959px) and (prefers-reduced-motion: no-preference)', () => {
    const playOnView = (trigger: Element, tl: gsap.core.Timeline, start = 'top 70%') =>
      ScrollTrigger.create({ trigger, start, end: 'max', once: true, onEnter: () => tl.play() });

    // Picture 1 — one turn, in the game's order: finish the sentence (it types in), fold the top
    // half back out of sight, then start the next sentence on the half that's left.
    const foldEl = section.querySelector<HTMLElement>('.still-fold');
    if (foldEl) {
      const flap = foldEl.querySelector('.still-fold__flap')!;
      const paperEl = foldEl.querySelector<HTMLElement>('.still-paper')!;
      const letters = (key: string) => foldEl.querySelectorAll(`[data-type="${key}"] .ch`);
      const type = () => ({ opacity: 1, duration: 0.01, stagger: 0.05, ease: 'none' });
      const button = foldEl.querySelector<HTMLElement>('.still-fold__button')!;
      const active = (on: boolean) => () => button.classList.toggle('is-active', on);
      const tap = (at: string) =>
        tl.to(button, { scale: 0.94, duration: 0.12, ease: 'power2.out' }, at).to(button, { scale: 1, duration: 0.25, ease: 'power2.out' });
      const tl = gsap.timeline({ paused: true, delay: 0.4 });
      // Finish the sentence: the button wakes up with the first letter, then gets tapped.
      tl.call(active(true), [], 0.05).to(letters('mine'), type(), 0);
      tap('+=0.5');
      // It folds; the button becomes "Send", inactive until the next start is written.
      tl.addLabel('fold', '+=0.15')
        .call(active(false), [], 'fold')
        .to(button.querySelector('[data-label="fold"]'), { opacity: 0, duration: 0.2 }, 'fold')
        .to(button.querySelector('[data-label="send"]'), { opacity: 1, duration: 0.2 }, 'fold+=0.15')
        .to(flap, { rotateX: 180, duration: 1.1, ease: 'power2.inOut' }, 'fold')
        .to(foldEl.querySelector('.still-fold__shade'), { opacity: 0.18, duration: 0.55, ease: 'power1.in' }, 'fold')
        .to(paperEl.querySelector('.still-paper__bands'), { opacity: 1, duration: 0.3 }, 'fold+=0.85')
        .to(paperEl, { y: () => -paperEl.offsetHeight / 2, duration: 0.7, ease: 'power2.inOut' }, 'fold+=1')
        .addLabel('next', '+=0.2')
        .call(active(true), [], 'next+=0.05')
        .to(letters('next'), type(), 'next');
      tap('+=0.5');
      // Sent: the page and button lift away, and the app's waiting screen says whose turn it is.
      const sentEl = foldEl.querySelector<HTMLElement>('.still-sent');
      if (sentEl) {
        tl.addLabel('sent', '+=0.3')
          .to([paperEl, button], { opacity: 0, y: '-=24', duration: 0.45, ease: 'power2.in' }, 'sent')
          .set(sentEl, { autoAlpha: 1 }, 'sent+=0.4')
          .fromTo(
            sentEl.querySelectorAll(':scope > :not(.still-sent__typing)'),
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.4, stagger: 0.12, ease: 'power2.out' },
            'sent+=0.4',
          )
          // A beat later Dana starts writing: the typing dots appear.
          .fromTo(sentEl.querySelector('.still-sent__typing'), { opacity: 0 }, { opacity: 1, duration: 0.3 }, '+=1');
      }
      playOnView(foldEl, tl);
    }

    // Picture 2 — the next player's turn: the phone draws itself, the note arrives showing only
    // the start the last player left, they finish the sentence, then tap "Fold the page".
    const phoneEl = section.querySelector<HTMLElement>('.still-phone');
    if (phoneEl) {
      const button = phoneEl.querySelector('.still-phone__button');
      const tl = gsap.timeline({ paused: true, delay: 0.3 });
      tl.fromTo(
        phoneEl.querySelector('.still-phone__outline rect'),
        { strokeDashoffset: 100 },
        { strokeDashoffset: 0, duration: 1.2, ease: 'power1.inOut' },
      )
        .fromTo(
          phoneEl.querySelectorAll('.still-phone__speaker, .still-phone__logo, .still-paper, .still-phone__button'),
          { opacity: 0, y: 8 },
          { opacity: 1, y: 0, duration: 0.4, stagger: 0.15, ease: 'power2.out' },
          '-=0.3',
        )
        .to(phoneEl.querySelectorAll('[data-type="reply"] .ch'), { opacity: 1, duration: 0.01, stagger: 0.05, ease: 'none' }, '+=0.5')
        .to(button, { scale: 0.94, duration: 0.12, ease: 'power2.out' }, '+=0.5') // the tap
        .to(button, { scale: 1, duration: 0.25, ease: 'power2.out' });
      playOnView(phoneEl, tl);
    }

    // Picture 3 — the folded strip shows only the first sentence; the folds swing open one at a
    // time (the paper grows with them), then everyone signs. The sheet's full height is reserved
    // from the start (only a clip grows), so nothing below ever moves.
    const storyEl = section.querySelector<HTMLElement>('.still-story');
    if (storyEl) {
      const lines = [...storyEl.querySelectorAll<HTMLElement>(':scope > p')];
      // Clip the sheet just below an element (the sides and top stay open for the shadow).
      const clipTo = (el: HTMLElement | null, extra = 0) =>
        `inset(-40px -40px ${el ? storyEl.offsetHeight - (el.offsetTop + el.offsetHeight) - extra : 0}px -40px)`;
      gsap.set(storyEl, { clipPath: clipTo(lines[0]) });
      const tl = gsap.timeline({ paused: true, delay: 0.3 });
      lines.slice(1).forEach((line, i) => {
        const at = i * 0.38;
        tl.to(storyEl, { clipPath: clipTo(line), duration: 0.35, ease: 'power2.inOut' }, at).fromTo(
          line,
          { rotateX: -90, opacity: 0 },
          { rotateX: 0, opacity: 1, duration: 0.35, ease: 'power2.out' },
          at,
        );
      });
      tl.to(storyEl, { clipPath: clipTo(null), duration: 0.35, ease: 'power2.inOut' }, '-=0.05').fromTo(
        storyEl.querySelectorAll('.signature'),
        { clipPath: 'inset(-20% 100% -20% 0)' },
        { clipPath: 'inset(-20% 0% -20% 0)', duration: 0.5, stagger: 0.35, ease: 'power1.inOut' },
        '+=0.1',
      );
      playOnView(storyEl, tl);
    }
  });

  // Load the WebGL sheet only on desktop with motion (phones get stills), and only when the
  // section is close, so it never costs the hero anything.
  const io = new IntersectionObserver(
    (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      loadSheet();
    },
    { rootMargin: '600px 0px' },
  );
  // Wait for the first scroll too: on tall screens the section is "close" at page load, and
  // building the sheet then blocks the page right while it opens (Lighthouse TBT).
  if (matchMedia('(min-width: 960px) and (prefers-reduced-motion: no-preference)').matches) {
    if (scrollY > 0) io.observe(section);
    else addEventListener('scroll', () => io.observe(section), { once: true, passive: true });
  }

  async function loadSheet() {
    const { PaperFold } = await import('../../scripts/paper-fold');
    const css = getComputedStyle(document.documentElement);
    const created = PaperFold.create(canvas, {
      paperSrc: paper,
      font: `400 20px ${css.getPropertyValue('--font-ui')}`,
      lineHeight: 30,
      lines: [
        { text: theirs, half: 'top' },
        { text: mine, half: 'top' },
        { text: next, half: 'bottom' },
      ],
    });
    if (!created) {
      visual.dataset.state = 'fallback';
      return;
    }
    await created.load();
    sheet = created;
    sheet.setProgress(fold.progress); // catch up with wherever scroll already is
    visual.dataset.state = 'ready';
  }
</script>

<style>
  /* The hero above already ends with a section's worth of space, so no extra gap on top. */
  .story {
    padding-block: 0 var(--section-y);
  }

  /* Phones: the column wrapper steps aside so the order is heading → picture → steps. */
  .story__copy {
    display: contents;
  }

  .story__intro {
    order: -2;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure);
    margin-block-end: var(--space-7);
  }

  .story__grid {
    display: grid;
    gap: var(--space-7);
  }

  .story__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: 0;
    list-style: none;
  }

  .story__step {
    display: flex;
    flex-direction: column;
    max-width: 34rem;
  }

  .story__step-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .story__step-inner p {
    font-size: var(--text-lg);
    color: var(--color-text-soft);
  }

  .story__num {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-text-soft);
  }

  /* The visual comes first on phones. */
  .story__stage {
    order: -1;
    display: grid;
    place-items: center;
  }

  .story__visual {
    width: min(100%, 460px);
  }

  .story__sheet {
    position: relative;
    width: 100%;
    aspect-ratio: 460 / 430;
    filter: drop-shadow(0 18px 22px rgb(0 0 0 / 0.14)) drop-shadow(0 2px 2px rgb(0 0 0 / 0.06));
  }

  /* Blank paper shows until the WebGL sheet is ready, pixel-matched to it. */
  .story__sheet::before {
    content: '';
    position: absolute;
    inset: 6px 24px 4px;
    background: var(--paper-texture) center / 100% 100% no-repeat;
  }

  [data-state='ready'] .story__sheet::before {
    opacity: 0;
    transition: opacity 0s var(--dur-fold);
  }

  .story__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-fold) var(--ease-out);
  }

  [data-state='ready'] .story__canvas {
    opacity: 1;
  }

  /* ---------- Step 2: the phone ---------- */
  .story__visual {
    position: relative;
  }

  .phone {
    position: absolute;
    inset-block-start: 50%;
