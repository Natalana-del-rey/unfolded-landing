---
/**
 * FAQ — intro beside an <Accordion> (see ui/Accordion.astro for the pattern and its a11y notes).
 */
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Accordion from '../ui/Accordion.astro';

interface Props {
  intro: CollectionEntry<'site'>['data']['faq'];
  items: CollectionEntry<'faq'>[];
}

const { intro, items } = Astro.props;
// Keep "4-digit" on one line: a hyphen between a digit and a word becomes a non-breaking hyphen.
const noBreak = (text: string) => text.replace(/(\d)-(\p{L})/gu, '$1‑$2');
const questions = items.map(({ id, data }) => ({ id, question: data.question, answer: noBreak(data.answer) }));
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <Container>
    <div class="faq__layout">
      <header class="faq__intro" data-reveal>
        <p class="eyebrow">{intro.eyebrow}</p>
        <Heading level={2} id="faq-title">{intro.title}</Heading>
      </header>

      <Accordion items={questions} idPrefix="faq" data-reveal />
    </div>
  </Container>
</section>

<style>
  .faq {
    /* No top padding: How it works above has the same background and already ends with a
       full section gap. The paper-tone closing band follows, so the bottom gap stays. */
    padding-block: 0 var(--section-y);
    background: var(--color-bg);
  }

  .faq__layout {
    display: grid;
    gap: var(--space-7);
  }

  .faq__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  /* Desktop: intro on the inline-start, questions beside it. */
  @media (min-width: 960px) {
    .faq__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
</style>
