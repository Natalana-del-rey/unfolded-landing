---
/**
 * HeroArt — the unicorn-cat peeking over a folded page it is holding up: "no peeking".
 *
 * The cat is the brand's own drawing (src/assets/img/mark-cat.svg, and its wink), untouched.
 * The page and the two paws are drawn here in the cat's coordinates, in the same marker line:
 * slightly uneven, nothing ruler-straight.
 * Decorative: the hero's text says what the game is.
 */
import catOpen from '../../assets/img/mark-cat.svg?raw';
import catWink from '../../assets/img/mark-cat-wink.svg?raw';

// Keep only the drawing (no <svg> wrapper, no embedded <style>); ids become data-part so the
// two drawings can share one page without duplicate ids.
const drawing = (svg: string) =>
  svg
    .slice(svg.indexOf('>') + 1, svg.lastIndexOf('</svg>'))
    .replace(/<style[\s\S]*?<\/style>/, '')
    .replace(/ id="/g, ' data-part="');
---

<div class="hero-art" aria-hidden="true">
  <svg class="hero-cat" viewBox="-230 -40 1640 1440">
    <defs>
      <!-- The cat only ever shows above the bottom of the page it hides behind. -->
      <clipPath id="hero-cat-clip"><rect x="-230" y="-400" width="1640" height="1700"></rect></clipPath>
      <!-- Everything above the page's bottom edge (same curve as .bottom-edge; they move together). -->
      <clipPath id="hero-unfold-clip">
        <path class="bottom-clip" d="M-500 900 H1700 V1367 L1268 1367 C900 1381 300 1384 -158 1367 L-500 1367 Z"></path>
      </clipPath>
    </defs>

    <g clip-path="url(#hero-cat-clip)">
      <g class="hero-cat__head">
        <g class="hero-cat__open" set:html={drawing(catOpen)} />
        <g class="hero-cat__wink" set:html={drawing(catWink)} />
      </g>
    </g>

    <g transform="rotate(-2.5 560 1160)">
      <!-- The folded page: paper first, then its outline and one fold, in marker. -->
      <path class="paper" d="M-150 948 Q560 932 1270 946 L1302 1150 L1268 1368 Q560 1384 -158 1368 L-124 1150 Z"></path>
      <path class="paper paper--shade" d="M-124 1150 Q560 1138 1302 1150 L1268 1368 Q560 1384 -158 1368 Z"></path>
      <g class="line">
        <path stroke-width="22" d="M-158 1367 C-148 1298 -137 1222 -124 1150 C-134 1086 -142 1018 -150 949 C200 936 820 933 1270 946 C1282 1012 1292 1086 1302 1150 C1290 1222 1278 1300 1268 1367"></path>
        <path stroke-width="10" d="M-122 1151 C200 1140 620 1137 900 1141 C1060 1143 1200 1146 1300 1150"></path>
      </g>

      <!-- More of the page, folded away until you scroll. Both panels are drawn in full and
           clipped to "everything above the bottom edge"; the script slides that edge (and the
           clip with it) down the zigzag, so lines keep their weight the whole way. -->
      <g clip-path="url(#hero-unfold-clip)">
        <path class="paper" d="M-158 1367 C300 1384 900 1381 1268 1367 L1300 1574 Q560 1590 -126 1574 Z"></path>
        <path class="paper paper--shade" d="M-126 1574 C300 1590 900 1588 1300 1574 L1266 1780 Q560 1796 -160 1780 Z"></path>
        <g class="line">
          <path stroke-width="22" d="M-158 1367 C-148 1436 -137 1506 -126 1574 C-138 1644 -150 1712 -160 1780"></path>
          <path stroke-width="22" d="M1268 1367 C1280 1436 1290 1506 1300 1574 C1290 1644 1278 1712 1266 1780"></path>
          <path stroke-width="10" d="M-156 1368 C60 1377 300 1384 620 1381 C860 1379 1080 1374 1266 1367"></path>
          <path stroke-width="10" d="M-124 1575 C140 1586 520 1591 800 1587 C1000 1584 1160 1579 1298 1574"></path>
        </g>
      </g>
      <g class="line"><path class="bottom-edge" stroke-width="22" d="M1268 1367 C900 1381 300 1384 -158 1367"></path></g>

      <!-- The paws holding the top edge. Each outline is one filled shape (outer minus inner),
           so its thickness wanders like a marker's. The two are deliberately not the same. -->
      <g class="paw" transform="translate(150 967)">
        <path class="paper" d="M-78 40 C-92 -10 -84 -78 -30 -92 C20 -104 78 -80 84 -22 C88 20 86 62 60 84 C30 104 -30 100 -58 84 C-72 74 -76 58 -78 40 Z"></path>
        <path class="ink" d="M-78 40 C-92 -10 -84 -78 -30 -92 C20 -104 78 -80 84 -22 C88 20 86 62 60 84 C30 104 -30 100 -58 84 C-72 74 -76 58 -78 40 Z M-53 36 C-65 -8 -57 -60 -21 -72 C19 -82 59 -64 65 -22 C69 14 67 48 49 64 C25 78 -21 76 -41 64 C-50 56 -52 46 -53 36 Z"></path>
        <g class="line">
          <path stroke-width="15" d="M-18 76 C-20 62 -17 50 -14 40"></path>
          <path stroke-width="14" d="M24 78 C24 64 27 52 31 44"></path>
        </g>
      </g>
      <g class="paw" transform="translate(905 962) rotate(5)">
        <path class="paper" d="M-72 34 C-86 -16 -70 -84 -18 -90 C34 -96 80 -66 82 -14 C84 26 80 66 52 82 C22 98 -34 96 -56 78 C-68 66 -70 50 -72 34 Z"></path>
        <path class="ink" d="M-72 34 C-86 -16 -70 -84 -18 -90 C34 -96 80 -66 82 -14 C84 26 80 66 52 82 C22 98 -34 96 -56 78 C-68 66 -70 50 -72 34 Z M-49 32 C-60 -10 -48 -64 -14 -69 C26 -73 57 -50 59 -12 C61 22 58 52 40 63 C16 75 -26 74 -39 61 C-47 53 -48 42 -49 32 Z"></path>
        <g class="line">
          <path stroke-width="14" d="M-14 72 C-15 58 -11 48 -7 40"></path>
          <path stroke-width="15" d="M22 73 C23 60 27 50 33 45"></path>
        </g>
      </g>
    </g>
  </svg>
</div>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../scripts/motion';

  // Two paws grab the top of the page, the cat comes up behind it, and winks once.
  // Reduced motion: nothing is hidden (see CSS), so the finished picture just shows.
  const cat = document.querySelector<SVGElement>('.hero-cat');
  if (cat && !prefersReducedMotion()) {
    const wink = () => {
      cat.classList.add('is-winking');
      setTimeout(() => cat.classList.remove('is-winking'), 260);
    };
    gsap
      .timeline({ delay: 0.45 })
      .fromTo(
        cat.querySelectorAll('.paw'),
        { opacity: 0, y: '-=46' },
        { opacity: 1, y: '+=46', duration: 0.32, stagger: 0.12, ease: 'back.out(2.4)' },
      )
      .to(cat.querySelector('.hero-cat__head'), { y: 0, duration: 0.7, ease: 'back.out(1.5)' }, '>-0.02')
      .call(wink, [], '>0.15');

    // Scrolling on: the page drops open, following the scroll. The bottom edge travels down
    // the zigzag (out to the right over the first panel, back in over the second), and the
    // clip that reveals the panels travels with it.
    const movers = cat.querySelectorAll('.bottom-edge, .bottom-clip');
    const STOPS = [
      [0, 0],
      [32, 207],
      [-2, 413],
    ];
    const fold = { at: 0 };
    gsap.to(fold, {
      at: STOPS.length - 1,
      ease: 'none',
      scrollTrigger: { trigger: document.body, start: 0, end: () => window.innerHeight * 0.6, scrub: 0.5 },
      onUpdate: () => {
        const i = Math.min(Math.floor(fold.at), STOPS.length - 2);
        const t = fold.at - i;
        const x = STOPS[i][0] + (STOPS[i + 1][0] - STOPS[i][0]) * t;
        const y = STOPS[i][1] + (STOPS[i + 1][1] - STOPS[i][1]) * t;
        movers.forEach((el) => el.setAttribute('transform', `translate(${x} ${y})`));
      },
    });
    ScrollTrigger.refresh();
  }
</script>

<style>
  /* The drawing sits bottom-right of the art area and scales with it. */
  .hero-art {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    height: 100%;
  }

  .hero-cat {
    display: block;
    width: min(100%, 500px);
    height: auto;
    /* Lifted off the bottom so the page has room to unfold before the next section's paper. */
    margin-block-end: var(--space-9);
    max-height: 100%;
    overflow: visible;
  }

  /* The brand drawing is built from parts; a hairline stroke closes the seams between them.
     (Only the parts: the wink's eyelid is a plain stroke and keeps its own thickness.) */
  .hero-cat__head :global(g[data-part] path) {
    fill: var(--color-text);
    stroke: var(--color-text);
    stroke-width: 2.2;
    stroke-linejoin: round;
  }

  .hero-cat .paper {
    fill: var(--color-bg);
  }

  /* Every other panel faces away a little: a faint paper tone gives the folds depth. */
  .hero-cat .paper--shade {
    fill: var(--color-surface);
  }

  .hero-cat .ink {
    fill: var(--color-text);
    fill-rule: evenodd;
  }

  .hero-cat .line path {
    fill: none;
    stroke: var(--color-text);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Behind the page; its tip would otherwise poke out beside the paw. */
  .hero-cat__head :global([data-part='whiskers-left']) {
    display: none;
  }

  /* Also behind the page: as the cat pops up it rises a touch too far before settling, and the
     tips of these showed for a moment as stray marks on the page's top edge. */
  .hero-cat__head :global([data-part='mouth']),
  .hero-cat__head :global([data-part='whiskers-right']) {
    display: none;
  }

  /* The wink is an instant swap, like a real blink (same as <Mark>). */
  .hero-cat__wink,
  .hero-cat.is-winking .hero-cat__open {
    visibility: hidden;
  }

  .hero-cat.is-winking .hero-cat__wink {
    visibility: visible;
  }

  /* Waiting behind the page (only when JS runs and motion is allowed; the script brings it up). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-cat__head {
      transform: translateY(420px);
    }

    :global(.js) .hero-cat .paw {
      opacity: 0;
    }
  }
</style>
