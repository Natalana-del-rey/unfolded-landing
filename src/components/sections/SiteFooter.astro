---
/** SiteFooter — credit (required by the brief) + a few quiet links. */
import Container from '../ui/Container.astro';
import Link from '../ui/Link.astro';

type Props = {
  footer: { credit: string; creditUrl: string; links: { label: string; href: string }[] };
};

const { footer } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<footer class="site-footer">
  <Container class="site-footer__inner">
    <p class="site-footer__credit">
      <Link href={footer.creditUrl} external variant="quiet">{footer.credit}</Link>
    </p>
    <nav aria-label="Footer">
      <ul class="site-footer__links" role="list">
        {
          footer.links.map((link) => (
            <li>
              <Link href={link.href} external={isExternal(link.href)} variant="quiet">
                {link.label}
              </Link>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--color-border);
    background: var(--color-bg);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .site-footer :global(.site-footer__inner) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-6);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phones: stack, credit first. */
  @media (max-width: 599px) {
    .site-footer :global(.site-footer__inner) {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
