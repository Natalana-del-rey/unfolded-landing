---
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import HeroArt from './HeroArt.astro';

interface Props {
  hero: CollectionEntry<'site'>['data']['hero'];
  appUrl: string;
}

const { hero, appUrl } = Astro.props;
// Each sentence of the headline stays on its own line where it fits ("Write one story." / "Lose control of the plot.").
const titleSentences = hero.title.split(/(?<=[.!?])\s+/);
---

<section class="hero" aria-labelledby="hero-title">
  <Container class="hero__grid">
    <div class="hero__copy">
      <p class="eyebrow" data-hero-item>{hero.eyebrow}</p>
      <Heading level={1} id="hero-title" class="hero__title" data-hero-title>{titleSentences.map((sentence, i) => <>{i > 0 && ' '}<span class="hero__title-sentence">{sentence}</span></>)}</Heading>
      <p class="hero__lead" data-hero-item="slide">{hero.lead}</p>

      <div class="hero__actions" data-hero-item>
        <Button href={appUrl} size="lg">{hero.primaryCta}</Button>
        <Button href={hero.secondaryCta.href} size="lg" variant="ghost">{hero.secondaryCta.label}</Button>
      </div>

      <dl class="hero__specs" data-hero-item>
        {
          hero.specs.map((spec) => (
            <div>
              <dt>{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- The story escaping from a folded page (decorative: the copy says what the game is). -->
    <div class="hero__art">
      <HeroArt />
    </div>
  </Container>
</section>

<script>
  import { gsap, duration, ease, revealDistance, prefersReducedMotion, showImmediately } from '../../scripts/motion';

  // ---- Entrance: the headline settles into place; the rest fades up after it.
  // (The art has its own entrance — the story escaping the fold — in HeroArt.)
  if (prefersReducedMotion()) {
    showImmediately('[data-hero-item]');
  } else {
    gsap
      .timeline({ defaults: { ease: ease('--ease-out'), duration: duration('--dur-fold') * 1.5 } })
      .fromTo('[data-hero-title]', { y: 28 }, { y: 0 }, 0)
      .fromTo('[data-hero-item]', { y: revealDistance() }, { opacity: 1, y: 0, stagger: 0.09 }, 0.12);
  }
</script>

<style>
  .hero {
    padding-block: var(--space-6) var(--section-y);
    overflow-x: clip;
  }

  :global(.hero__grid) {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  /* A sentence only breaks inside itself when it can't fit on one line (narrow phones). */
  .hero__title-sentence {
    display: inline-block;
  }

  .hero__lead {
    max-width: 34rem;
    font-size: var(--text-lg);
    color: var(--color-text-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-2);
  }

  .hero__specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    margin-top: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  /* Value above label, as in the app; the DOM keeps the correct dt → dd order. */
  .hero__specs div {
    display: flex;
    flex-direction: column-reverse;
  }

  .hero__specs dd {
    margin: 0;
    font-family: var(--font-wordmark);
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .hero__specs dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Phones and small tablets: no illustration (Natalie: it didn't work at that size) —
     the hero is just the copy. */
  .hero__art {
    display: none;
  }

  @media (min-width: 960px) {
    /* The hero fills the first screen (minus the header), so the next section — which opens
       with its own sheet of paper — never peeks in and competes with the hero's folded note. */
    .hero {
      min-height: calc(100svh - var(--header-height, 80px));
      display: grid;
      align-content: center;
    }

    :global(.hero__grid) {
      position: relative;
    }

    .hero__copy {
      position: relative;
      z-index: 1;
    }

    /* The art spans the right two-thirds behind the copy; the folded page sits beside the stats. */
    .hero__art {
      display: block;
      position: absolute;
      inset-block: calc(-1 * var(--space-4)) calc(-1 * var(--space-7));
      inset-inline-end: var(--gutter);
      width: calc((100% - 2 * var(--gutter)) * 0.66);
    }
  }
</style>
