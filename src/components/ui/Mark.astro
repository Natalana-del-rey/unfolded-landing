---
/**
 * Mark — the Unfolded unicorn, from the app's opening screen.
 * It winks on hover, on focus within its parent, and whenever a script calls
 * `wink(el)` (see src/scripts/wink.ts). The swap is instant, like a real blink
 * (the app animates it with steps(), not a fade).
 * Decorative: always hidden from screen readers.
 */
import { Image } from 'astro:assets';
import mark from '../../assets/img/mark.png';
import markWink from '../../assets/img/mark-wink.png';

type Props = {
  size?: number;
  class?: string;
};

const { size = 64, class: className } = Astro.props;
---

<span class:list={['mark', className]} style={`--mark-size: ${size}px`} aria-hidden="true" data-mark>
  <Image src={mark} alt="" width={size} height={size} densities={[1, 2]} class="mark__open" />
  <Image src={markWink} alt="" width={size} height={size} densities={[1, 2]} class="mark__wink" />
</span>

<style>
  .mark {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
    width: var(--mark-size);
    height: var(--mark-size);
  }

  .mark :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mark__wink,
  .mark:is(:hover, .is-winking) .mark__open {
    visibility: hidden;
  }

  .mark:is(:hover, .is-winking) .mark__wink {
    visibility: visible;
  }
</style>
