---
/** Container — centres content and keeps it off the screen edges. */
type Props = {
  width?: 'default' | 'narrow';
  class?: string;
};

const { width = 'default', class: className } = Astro.props;
---

<div class:list={['container', `container--${width}`, className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: calc(var(--container-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .container--narrow {
    max-width: calc(var(--container-narrow) + 2 * var(--gutter));
  }
</style>
