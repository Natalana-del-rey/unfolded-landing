---
/** Badge — a small label, like a tag stuck on the paper. */
type Props = {
  variant?: 'outline' | 'solid' | 'soft';
  class?: string;
};

const { variant = 'outline', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-dot);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge--outline {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .badge--solid {
    background: var(--color-action);
    color: var(--color-action-text);
  }

  .badge--soft {
    background: var(--color-surface-tag);
    color: var(--color-text);
  }
</style>
