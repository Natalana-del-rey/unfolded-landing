---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Temporary: proves the content collections load. Replaced by real sections next.
const site = await getEntry('site', 'home');
if (!site) throw new Error('src/content/site.json is missing the "home" entry');
const counts = await Promise.all(
  (['story', 'features', 'steps', 'faq', 'testimonials'] as const).map(
    async (name) => `${name}: ${(await getCollection(name)).length}`,
  ),
);
---

<BaseLayout title={site.data.meta.title} description={site.data.meta.description}>
  <main id="main">
    <h1>{site.data.hero.title}</h1>
    <ul>{counts.map((c) => <li>{c}</li>)}</ul>
  </main>
</BaseLayout>
