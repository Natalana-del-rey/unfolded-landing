---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';

const site = await getEntry('site', 'home');
if (!site) throw new Error('src/content/site.json is missing the "home" entry');
const { meta, appUrl, hero } = site.data;
---

<BaseLayout title={meta.title} description={meta.description}>
  <SiteHeader appUrl={appUrl} ctaLabel={hero.primaryCta} />
  <main id="main">
    <Hero hero={hero} appUrl={appUrl} />
  </main>
</BaseLayout>
