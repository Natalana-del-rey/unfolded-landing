---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import PaperStory from '../components/sections/PaperStory.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';

const site = await getEntry('site', 'home');
if (!site) throw new Error('src/content/site.json is missing the "home" entry');
const { meta, appUrl, hero, story, howItWorks, faq, finalCta, footer } = site.data;
const storySteps = (await getCollection('story')).sort((a, b) => a.data.order - b.data.order);
const faqItems = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const howSteps = (await getCollection('steps')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={meta.title} description={meta.description}>
  <SiteHeader appUrl={appUrl} ctaLabel={hero.primaryCta} />
  <main id="main">
    <Hero hero={hero} appUrl={appUrl} />
    <PaperStory intro={story} steps={storySteps} sheet={hero.sheet} />
    <HowItWorks intro={howItWorks} steps={howSteps} />
    <Faq intro={faq} items={faqItems} />
    <FinalCta cta={finalCta} appUrl={appUrl} />
  </main>
  <SiteFooter footer={footer} />
</BaseLayout>

<script>
  import { initReveals } from '../scripts/motion';
  initReveals();
</script>
