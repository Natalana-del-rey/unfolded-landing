{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "room" }],
      "destination": "https://play.unfolded-game.com/",
      "permanent": false
    },
    { "source": "/en", "destination": "https://play.unfolded-game.com/en", "permanent": false },
    { "source": "/en/", "destination": "https://play.unfolded-game.com/en", "permanent": false },
    { "source": "/privacy.html", "destination": "https://play.unfolded-game.com/privacy.html", "permanent": false }
  ]
}
